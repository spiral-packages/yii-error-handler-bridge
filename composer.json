{
    "name": "spiral-packages/yii-error-handler-bridge",
    "description": "Yii Error Handler integration package for Spiral Framework",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "spiral",
        "spiral-framework",
        "error-handling"
    ],
    "homepage": "https://github.com/spiral-packages/yii-error-handler-bridge",
    "authors": [
        {
            "name": "kastahov",
            "email": "kastahov1021@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Aleksei Gagarin (roxblnfk)",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "require": {
        "php": "^8.2",
        "spiral/boot": "^3.15",
        "spiral/exceptions": "^3.15",
        "yiisoft/error-handler": "4.3.2"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "buggregator/trap": "^1.13",
        "llm/skills": "^1.16",
        "mockery/mockery": "^1.6.12",
        "roxblnfk/unpoly": "^1.8",
        "spiral/http": "^3.0",
        "testo/bridge-mockery": "^0.1.2",
        "testo/testo": "^0.10.56"
    },
    "autoload": {
        "psr-4": {
            "Spiral\\YiiErrorHandler\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\YiiErrorHandler\\Tests\\": "tests"
        },
        "files": [
            "tests/polyfill.php"
        ]
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=tools/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=tools/code-style/.php-cs-fixer.dist.php",
        "test": "vendor/bin/testo",
        "psalm": "psalm -c tools/psalm/psalm.xml",
        "psalm:baseline": "psalm -c tools/psalm/psalm.xml --set-baseline=tools/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c tools/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "sandbox": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 tests/Acceptance/server.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "tools"
        },
        "spiral": {
            "bootloaders": [
                "Spiral\\YiiErrorHandler\\Bootloader\\YiiErrorHandlerBootloader"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
